<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Jtext103.CFET2.HTTPCommunicationModule</PackageId>
    <Version>1.0.2</Version>
    <Authors>Jtext103</Authors>
    <Description>HTTP communication module for CFET2 resource access.</Description>
    <PackageTags>CFET2;HTTP;communication;IoT</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
	
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>


	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="MessagePack" Version="3.1.8" />
	</ItemGroup>
	
  <ItemGroup>
    <PackageReference Include="CFET2Core" Version="3.3.0" />
  </ItemGroup>

</Project>
